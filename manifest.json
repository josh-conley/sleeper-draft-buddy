{
  "manifest_version": 3,
  "name": "Sleeper Draft Buddy",
  "version": "1.0.0",
  "description": "Paste a list of player names and get a live draft overlay that hides players as they are drafted, on either Sleeper board.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Sleeper Draft Buddy",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://sleeper.com/*",
    "https://api.sleeper.app/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://sleeper.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/main.js",
        "src/lib/*.js",
        "src/panel/*.js",
        "src/panel/panel.css"
      ],
      "matches": [
        "https://sleeper.com/*"
      ]
    }
  ]
}
